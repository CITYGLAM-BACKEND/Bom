<?xml version="1.0" encoding="UTF-8"?>
<!-- Line above is the XML declaration: XML version 1.0, saved in UTF-8 encoding. It must stay the very first line -->

<!-- Root element of every Maven POM. xmlns is the default namespace of the POM, xmlns:xsi declares the XML Schema Instance namespace, and xsi:schemaLocation tells the parser where the schema (XSD) lives so IDEs can validate and auto-complete the file -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the POM structure itself. Maven always uses 4.0.0 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- PARENT: this project inherits properties, dependency management and plugins from the cityglam-bom POM -->
    <parent>
        <!-- Group ID of the parent project -->
        <groupId>com.cityglam</groupId>

        <!-- Artifact ID of the parent: the cityglam-bom project that holds common versions and settings -->
        <artifactId>Bom</artifactId>

        <!-- Version of the parent. SNAPSHOT means it is still in development -->
        <version>0.0.1-SNAPSHOT</version>
        <!-- No relativePath given, so Maven uses the default ../pom.xml, which is where cityglam-bom sits because this module is listed in its modules section -->
    </parent>

    <!-- Group ID of THIS project (the organization namespace) -->
    <groupId>com.cityglam</groupId>

    <!-- Artifact ID of THIS project: the module name. Other microservices add it as a dependency to reuse the shared code -->
    <artifactId>common</artifactId>

    <!-- Version of this library. It is read from the common-lib.version property defined in the parent (1.0.0), so the version is controlled from one place -->
    <version>${common-lib.version}</version>

    <!-- Human-readable name shown in IDEs and Maven output -->
    <name>common</name>

    <!-- Short description: shared code (for example DTOs, exceptions, utilities) used by all cityglam microservices -->
    <description>Provides centralized dependency and version management for all city glam microservices, ensuring
        consistent and compatible library versions across the entire project.
    </description>

    <!-- Project website URL. Empty here, a placeholder generated by Spring Initializr -->
    <url/>

    <!-- LICENSES: license information (informational metadata) -->
    <licenses>
        <!-- Empty license entry, a placeholder you can fill in or delete -->
        <license/>
    </licenses>

    <!-- DEVELOPERS: people who maintain the project (informational metadata) -->
    <developers>
        <!-- Empty developer entry, a placeholder you can fill in or delete -->
        <developer/>
    </developers>
    <!-- SCM: Source Control Management details, where the code is hosted. All empty placeholders here -->

    <scm>
        <!-- Read-only connection URL to the repository (empty) -->
        <connection/>
        <!-- Connection URL for developers with write access (empty) -->
        <developerConnection/>
        <!-- Tag or branch name in the repository (empty) -->
        <tag/>
        <!-- Browsable URL of the repository (empty) -->
        <url/>
    </scm>

    <!-- DEPENDENCIES: libraries Maven downloads and adds to the classpath of this module -->
    <dependencies>
        <!-- common is used by the servlet services AND the reactive Api-Gateway, so it must not pull in Spring MVC or
             WebFlux. It only needs the plain types below; versions come from the Spring Boot BOM in the parent -->
        <!-- spring-web: HttpStatus, HttpHeaders, ResponseEntity and RequestContextHolder -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Jackson annotations: @JsonInclude / @JsonValue on the response DTOs -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Auto-configuration of the message reader (MessagesAutoConfiguration). Every service already has it -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Redis: the response messages live there (written by Master-Data-Service, read by every service). Not
             optional: every service that depends on common gets the Redis client and its auto-configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Logging API (every service has it through Spring Boot) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Servlet API for ApiResponses (servlet services). provided: every servlet service has it already, the
             reactive gateway never uses ApiResponses and does not get the servlet API through common -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Start of the Lombok dependency -->
        <dependency>
            <!-- Lombok's group ID -->
            <groupId>org.projectlombok</groupId>
            <!-- Lombok: generates getters, setters, constructors and builders at compile time using annotations like @Data -->
            <artifactId>lombok</artifactId>
            <!-- optional true: used while compiling this module but NOT passed on to projects that depend on common, so they must add Lombok themselves if they need it -->
            <optional>true</optional>
            <!-- Version taken from the lombok.version property in the parent -->
            <version>${lombok.version}</version>
        </dependency>

        <!-- OpenAPI @Schema annotations only (no Swagger UI, no Spring MVC). Same version springdoc 3.2.0 uses -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.55</version>
        </dependency>
        <!-- Message export (JSON files for the frontend): checks a written file by reading it back. Optional: the
             services that export have Jackson through their web starter -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Table-wise Flyway (db/migration/<table>/V1__..., one history per table). Optional: only services that
             have Flyway themselves (and a db/migration/order.txt) use it -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- This is a plain library JAR other services depend on: do not repackage it into an executable Boot JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
