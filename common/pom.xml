<?xml version="1.0" encoding="UTF-8"?>
<!-- Line above is the XML declaration: XML version 1.0, saved in UTF-8 encoding. It must stay the very first line -->

<!-- Root element of every Maven POM. xmlns is the default namespace of the POM, xmlns:xsi declares the XML Schema Instance namespace, and xsi:schemaLocation tells the parser where the schema (XSD) lives so IDEs can validate and auto-complete the file -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the POM structure itself. Maven always uses 4.0.0 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- PARENT: this project inherits properties, dependency management and plugins from the cityglam-bom POM -->
    <parent>
        <!-- Group ID of the parent project -->
        <groupId>com.cityglam</groupId>

        <!-- Artifact ID of the parent: the cityglam-bom project that holds common versions and settings -->
        <artifactId>Bom</artifactId>

        <!-- Version of the parent. SNAPSHOT means it is still in development -->
        <version>0.0.1-SNAPSHOT</version>
        <!-- No relativePath given, so Maven uses the default ../pom.xml, which is where cityglam-bom sits because this module is listed in its modules section -->
    </parent>

    <!-- Group ID of THIS project (the organization namespace) -->
    <groupId>com.cityglam</groupId>

    <!-- Artifact ID of THIS project: the module name. Other microservices add it as a dependency to reuse the shared code -->
    <artifactId>common</artifactId>

    <!-- Version of this library. It is read from the common-lib.version property defined in the parent (1.0.0), so the version is controlled from one place -->
    <version>${common-lib.version}</version>

    <!-- Human-readable name shown in IDEs and Maven output -->
    <name>common</name>

    <!-- Short description: shared code (for example DTOs, exceptions, utilities) used by all cityglam microservices -->
    <description>Provides centralized dependency and version management for all city glam microservices, ensuring
        consistent and compatible library versions across the entire project.
    </description>

    <!-- Project website URL. Empty here, a placeholder generated by Spring Initializr -->
    <url/>

    <!-- LICENSES: license information (informational metadata) -->
    <licenses>
        <!-- Empty license entry, a placeholder you can fill in or delete -->
        <license/>
    </licenses>

    <!-- DEVELOPERS: people who maintain the project (informational metadata) -->
    <developers>
        <!-- Empty developer entry, a placeholder you can fill in or delete -->
        <developer/>
    </developers>
    <!-- SCM: Source Control Management details, where the code is hosted. All empty placeholders here -->

    <scm>
        <!-- Read-only connection URL to the repository (empty) -->
        <connection/>
        <!-- Connection URL for developers with write access (empty) -->
        <developerConnection/>
        <!-- Tag or branch name in the repository (empty) -->
        <tag/>
        <!-- Browsable URL of the repository (empty) -->
        <url/>
    </scm>

    <!-- DEPENDENCIES: libraries Maven downloads and adds to the classpath of this module -->
    <dependencies>
        <!-- Start of the Spring MVC dependency -->
        <dependency>
            <!-- Spring Boot's group ID -->
            <groupId>org.springframework.boot</groupId>
            <!-- Spring Boot web starter for Spring MVC: gives REST controllers, JSON support and an embedded server. Version comes from the Spring Boot BOM in the parent, so none is written here -->
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Start of the Lombok dependency -->
        <dependency>
            <!-- Lombok's group ID -->
            <groupId>org.projectlombok</groupId>
            <!-- Lombok: generates getters, setters, constructors and builders at compile time using annotations like @Data -->
            <artifactId>lombok</artifactId>
            <!-- optional true: used while compiling this module but NOT passed on to projects that depend on common, so they must add Lombok themselves if they need it -->
            <optional>true</optional>
            <!-- Version taken from the lombok.version property in the parent -->
            <version>${lombok.version}</version>
        </dependency>

        <!-- Start of the springdoc dependency -->
        <dependency>
            <!-- springdoc's group ID -->
            <groupId>org.springdoc</groupId>
            <!-- springdoc OpenAPI starter: generates API documentation and the Swagger UI page for Spring MVC apps -->
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- Version taken from the spring-doc.version property in the parent. A version is written here because the parent's import of this library does not reliably manage it -->
            <version>${spring-doc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- This is a plain library JAR other services depend on: do not repackage it into an executable Boot JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
